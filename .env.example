# Credentials are stored in macOS Keychain through Settings, never here.
OUTREACH_DB=.local/outreach.sqlite
# Disable automatic contact research; manual research remains available.
OUTREACH_AUTO_RESEARCH=false
# Fill missing roles from public postings, independently of contact research.
OUTREACH_AUTO_ROLE_EXTRACTION=true
# Fixed localhost Ollama service; use the installed qwen3:4b model.
OLLAMA_MODEL=qwen3:4b
# No invented polling interval. All three values required to enable scheduling.
TSENTA_POLL_ENABLED=false
TSENTA_POLL_SECONDS=
TSENTA_POLL_SUPPORT_REFERENCE=
# Separate fictional demo only; never enable against the real database.
OUTREACH_DEMO=false
