# Credentials are stored in macOS Keychain through Settings, never here.
OUTREACH_DB=.local/outreach.sqlite
# Disable automatic contact research; manual research remains available.
OUTREACH_AUTO_RESEARCH=false
# Fill missing roles from public postings, independently of contact research.
OUTREACH_AUTO_ROLE_EXTRACTION=true
# Fixed localhost Ollama service; use the installed qwen3:4b model.
OLLAMA_MODEL=qwen3:4b
# No invented polling interval. All three values required to enable scheduling.
TSENTA_POLL_ENABLED=false
TSENTA_POLL_SECONDS=
TSENTA_POLL_SUPPORT_REFERENCE=
# Separate fictional demo only; never enable against the real database.
OUTREACH_DEMO=false
# Configurable model service; host Docker uses http://host.docker.internal:11434
OLLAMA_URL=http://127.0.0.1:11434
RETRIEVAL_EMBEDDING_THRESHOLD=50
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VERSION=1
# Remote mode fails closed unless auth, HTTPS and allowlists are explicitly set.
OUTREACH_REMOTE=false
CREDENTIAL_STORE=keychain
# Secrets and DATABASE_URL belong in deployment secret injection, not committed files.
# EXTERNAL_BASE_URL=https://your-private-host
# ALLOWED_HOSTS=your-private-host
# ALLOWED_ORIGINS=https://your-private-host
TSENTA_OAUTH_CALLBACK=http://127.0.0.1:8765/api/tsenta/callback
TSENTA_CALLBACK_VERIFIED=false
LANGFUSE_ENABLED=false
TRACE_RAW_CONTENT=false
LANGSMITH_TRACING=false
